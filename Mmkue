-- Check for table that is shared between executions.
if not shared then
	return warn("No shared, no script.")
end

-- Initialize Luraph globals if they do not exist.
loadstring("getfenv().LPH_NO_VIRTUALIZE = function(...) return ... end")()
getfenv().PP_SCRAMBLE_NUM = function(...) return ... end
getfenv().PP_SCRAMBLE_STR = function(...) return ... end
getfenv().PP_SCRAMBLE_RE_NUM = function(...) return ... end

local PintolHub = { queued = false, silent = false }

-- Services.
local playersService = game:GetService("Players")
local runService = game:GetService("RunService")
local replicatedStorage = game:GetService("ReplicatedStorage")
local workspace = game:GetService("Workspace")
local virtualUser = game:GetService("VirtualUser")
local lighting = game:GetService("Lighting")

local localPlayer = playersService.LocalPlayer

-- State.
local state = {
	match = {},
	performance = {},
	player = {},
	lobby = {},
	macro = {},
	antiBan = {}
}

---Anti-AFK setup to prevent disconnects.
localPlayer.Idled:Connect(function()
	virtualUser:CaptureController()
	virtualUser:ClickButton2(Vector2.new())
end)

---Find and fire an event by fuzzy name.
---@param name string
local function fireNetworkEvent(name, ...)
	for _, inst in ipairs(replicatedStorage:GetDescendants()) do
		if inst:IsA("RemoteEvent") and string.find(inst.Name, name) then
			inst:FireServer(...)
		elseif inst:IsA("RemoteFunction") and string.find(inst.Name, name) then
			task.spawn(function(...) inst:InvokeServer(...) end, ...)
		end
	end
end

---Applies aggressive low performance optimizations.
local function applyLowPerformance()
	if not state.performance.lowPerf then return end
	for _, obj in ipairs(workspace:GetDescendants()) do
		if obj:IsA("BasePart") then
			obj.Material = Enum.Material.Plastic
			obj.Reflectance = 0
		elseif obj:IsA("Decal") or obj:IsA("Texture") then
			obj.Transparency = 1
		elseif obj:IsA("ParticleEmitter") or obj:IsA("Trail") then
			obj.Enabled = false
		end
	end
	lighting.GlobalShadows = false
end

---Core loop for active toggles.
local function onHeartbeat()
	if state.match.skipWave then
		fireNetworkEvent("Skip")
		fireNetworkEvent("Vote")
	end
	
	if state.match.speed2x then
		fireNetworkEvent("Speed", 2)
	elseif state.match.speed3x then
		fireNetworkEvent("Speed", 3)
	end
	
	if state.match.autoAbility then
		fireNetworkEvent("Ability")
	end
	
	if state.match.skipCutscene then
		fireNetworkEvent("Cutscene")
	end

	if state.player.followEnemy then
		local char = localPlayer.Character
		if char and char:FindFirstChild("HumanoidRootPart") then
			local mobs = workspace:FindFirstChild("Mobs") or workspace:FindFirstChild("Enemies")
			if mobs then
				for _, mob in ipairs(mobs:GetChildren()) do
					if mob:FindFirstChild("HumanoidRootPart") then
						char.HumanoidRootPart.CFrame = mob.HumanoidRootPart.CFrame * CFrame.new(0, 5, 0)
						break
					end
				end
			end
		end
	end
end

---This is called when initialization errors.
---@param error string
local function onInitializeError(error)
	warn("Failed to initialize.")
	warn(error)
	warn(debug.traceback())
end

---Main initialization.
local function initializeScript()
	local rayfieldReq = request({Url = "https://sirius.menu/rayfield", Method = "GET"})
	local Rayfield = loadstring(rayfieldReq.Body)()

	local Window = Rayfield:CreateWindow({
